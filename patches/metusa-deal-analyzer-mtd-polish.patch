+        f"YTD {format_gbp_from_pence(snapshot.get('yearToDateNetPence', 0))}"
+    )
+    lines.append(f"Entries in period: {snapshot.get('entryCount', 0)}")
+    lines.append("HMRC submit: no")
+    return lines
