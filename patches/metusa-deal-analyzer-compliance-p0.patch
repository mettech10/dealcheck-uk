+os.environ.setdefault("FLASK_ENV", "testing")
+os.environ["COMPLIANCE_FORCE_MEMORY_STORE"] = "1"
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
