+            headers=_sb_headers(),
+        )
+    except requests.RequestException as exc:
+        return {
+            "backend": "supabase",
+            "tables": "unreachable",
+            "ready": False,
+            "message": str(exc)[:200],
+            "hint": MIGRATION_HINT,
+        }
+    if resp.status_code == 200:
+        return {"backend": "supabase", "tables": "ok", "ready": True}
+    return {
+        "backend": "supabase",
+        "tables": "missing",
+        "ready": False,
+        "http": resp.status_code,
+        "message": (resp.text or "")[:200],
+        "hint": MIGRATION_HINT,
+    }
+
