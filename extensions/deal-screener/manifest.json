{
  "manifest_version": 3,
  "name": "Metalyzi Deal Screener",
  "version": "0.1.0",
  "description": "Closed beta: capture a Rightmove listing (user-initiated) and screen it against your rules before opening in Metalyzi.",
  "action": {
    "default_title": "Metalyzi Deal Screener",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": [
    "https://metalyzi.co.uk/*",
    "https://www.metalyzi.co.uk/*",
    "https://metusa-deal-analyzer.onrender.com/*",
    "http://localhost:3000/*",
    "http://localhost:5000/*"
  ],
  "optional_host_permissions": ["http://127.0.0.1:3000/*"]
}
